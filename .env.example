# Docker Compose
HTTP_PORT=8080
DATABASE_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
XDEBUG_MODE=off

POSTGRES_DB=wishlist
POSTGRES_USER=wishlist
POSTGRES_PASSWORD=wishlist
RABBITMQ_USER=wishlist
RABBITMQ_PASSWORD=wishlist

APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost:8080

DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?serverVersion=17&charset=utf8"
REDIS_URL=redis://redis:6379
MESSENGER_TRANSPORT_DSN=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672/%2f/messages
